# ════════════════════════════════════════════════════════════════════
#  EMBEDDING PROVIDER  —  pick one
# ════════════════════════════════════════════════════════════════════
# ollama  → local, free, best for dev  (needs: ollama pull nomic-embed-text)
# google  → cloud, free tier, best for Insforge / no-GPU deploys
# openai  → cloud, paid, highest quality

EMBED_PROVIDER=ollama

# Ollama (only when EMBED_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Google (only when EMBED_PROVIDER=google)
# Free key → https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=your_google_api_key
# GOOGLE_EMBED_MODEL=models/text-embedding-004

# OpenAI (only when EMBED_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_EMBED_MODEL=text-embedding-3-small


# ════════════════════════════════════════════════════════════════════
#  VECTOR STORE  —  pick one
# ════════════════════════════════════════════════════════════════════
# pinecone  → managed cloud, free tier, zero setup
# postgres  → self-hosted or Insforge/Supabase postgres + pgvector

VECTOR_STORE=pinecone

# Pinecone (only when VECTOR_STORE=pinecone)
# Free key → https://app.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=crag-index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Postgres (only when VECTOR_STORE=postgres)
# Format: postgresql://user:password@host:5432/dbname
# POSTGRES_URL=postgresql://postgres:password@localhost:5432/ragdb


# ════════════════════════════════════════════════════════════════════
#  LLM  —  Groq (free)
# ════════════════════════════════════════════════════════════════════
# Free key → https://console.groq.com
GROQ_API_KEY=your_groq_api_key
# Options: llama-3.1-8b-instant (fast) | llama-3.3-70b-versatile (smarter)
GROQ_MODEL=llama-3.1-8b-instant


# ════════════════════════════════════════════════════════════════════
#  APP
# ════════════════════════════════════════════════════════════════════
API_URL=http://localhost:8000
CHUNK_SIZE=400
CHUNK_OVERLAP=80
EMBED_DIM=768
